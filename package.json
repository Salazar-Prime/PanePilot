{
  "name": "project-console",
  "productName": "PanePilot",
  "version": "0.3.1",
  "private": true,
  "description": "PanePilot desktop control center for local and remote agent projects",
  "author": "Salazar-Prime",
  "repository": {
    "type": "git",
    "url": "https://github.com/Salazar-Prime/PanePilot.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "postinstall": "electron-rebuild -f -w node-pty && node scripts/prepare-node-pty.mjs",
    "predev": "node scripts/prepare-electron.mjs && node scripts/prepare-node-pty.mjs",
    "dev": "electron-vite dev",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:typecheck": "npm --prefix docs run typecheck",
    "prestart": "node scripts/prepare-electron.mjs && node scripts/prepare-node-pty.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node --max-old-space-size=4096 node_modules/electron-vite/bin/electron-vite.js build",
    "package:mac": "npm run build && node scripts/prepare-node-pty.mjs && electron-builder --mac --dir --arm64",
    "dist:mac": "npm run build && node scripts/prepare-node-pty.mjs && electron-builder --mac dmg zip --arm64",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "6.4.1",
    "@monaco-editor/react": "4.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "5.5.0",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.56.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "4.8.69",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "gaxios@7.1.3": {
      "rimraf": "6.1.3"
    },
    "google-gax": {
      "rimraf": "6.1.3"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.1",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "2.3.0",
    "typescript": "5.7.2",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }
}
